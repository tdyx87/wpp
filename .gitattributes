# gf_text.h is GENERATED by build/gen_gf_text.py, which writes UTF-8 bytes with
# LF endings so that the Chinese literals stay byte-exact.  With core.autocrlf
# on, a plain checkout would hand back CRLF and a regenerated file would then
# show every single line as modified.  Pinning this one path to LF keeps the
# documented workflow ("run the generator, commit the result") idempotent.
#
# Nothing else is pinned: the hand-written sources in this project are GBK with
# CRLF endings (see the editing rules in 代码分析与优化报告.md), and they are
# deliberately left to the platform default.
games/guofeng/gf_text.h text eol=lf
