{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 21,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "vs2008",
      "displayName": "Visual Studio 2008 (Win32) - verified toolchain",
      "description": "cl 15.00 + Windows SDK v6.0A + NASM. Requires nasm on PATH.",
      "generator": "Visual Studio 9 2008",
      "binaryDir": "${sourceDir}/build/vs2008",
      "cacheVariables": {
        "CMAKE_WARN_VS9": "OFF"
      }
    },
    {
      "name": "vs2022",
      "displayName": "Visual Studio 2022 (Win32)",
      "description": "Modern toolset. Must be 32-bit: -A Win32 is implied.",
      "generator": "Visual Studio 17 2022",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/vs2022"
    },
    {
      "name": "vs2019",
      "displayName": "Visual Studio 2019 (Win32)",
      "generator": "Visual Studio 16 2019",
      "architecture": {
        "value": "Win32",
        "strategy": "set"
      },
      "binaryDir": "${sourceDir}/build/vs2019"
    },
    {
      "name": "vs2017",
      "displayName": "Visual Studio 2017 (Win32) via Ninja",
      "description": "MSVC 14.16 (v141) + Windows 10 SDK 10.0.19041.0 driven by Ninja. The VS2017 *generator* (MSBuild) hangs on its CMake try_compiles in this environment, so we use the Ninja generator with the toolchain pointed at the non-default install C:\\2017\\Community. The bundled environment supplies INCLUDE/LIB/PATH, so `cmake --preset vs2017` works from any prompt.",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build/vs2017",
      "environment": {
        "PATH": "C:/2017/Community/VC/Tools/MSVC/14.16.27023/bin/HostX86/x86;C:/Program Files (x86)/Windows Kits/10/bin/10.0.19041.0/x86;C:/Strawberry/c/bin;C:/Windows/system32;C:/Windows;C:/Windows/System32/Wbem;C:/Windows/System32/WindowsPowerShell/v1.0/",
        "INCLUDE": "C:/2017/Community/VC/Tools/MSVC/14.16.27023/ATLMFC/include;C:/2017/Community/VC/Tools/MSVC/14.16.27023/include;C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/ucrt;C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/shared;C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/um;C:/Program Files (x86)/Windows Kits/10/Include/10.0.19041.0/winrt",
        "LIB": "C:/2017/Community/VC/Tools/MSVC/14.16.27023/ATLMFC/lib/x86;C:/2017/Community/VC/Tools/MSVC/14.16.27023/lib/x86;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.19041.0/ucrt/x86;C:/Program Files (x86)/Windows Kits/10/Lib/10.0.19041.0/um/x86",
        "LIBPATH": "C:/2017/Community/VC/Tools/MSVC/14.16.27023/ATLMFC/lib/x86;C:/2017/Community/VC/Tools/MSVC/14.16.27023/lib/x86;C:/2017/Community/VC/Tools/MSVC/14.16.27023/lib/x86/store/references;C:/Windows/Microsoft.NET/Framework/v4.0.30319"
      },
      "cacheVariables": {
        "CMAKE_ASM_NASM_COMPILER": "C:/Strawberry/c/bin/nasm.exe"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "vs2008-release",
      "configurePreset": "vs2008",
      "configuration": "Release"
    },
    {
      "name": "vs2008-debug",
      "configurePreset": "vs2008",
      "configuration": "Debug"
    },
    {
      "name": "vs2022-release",
